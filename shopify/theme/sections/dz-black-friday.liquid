{%- comment -%}
  Home Black Friday, nella veste attuale del sito: stessa apertura a tutto
  schermo della home (classi .dzh di dz-apertura.css), stesse intestazioni
  (.block .head), stesse card prodotto (dz-card) e stessi riquadri dei
  servizi (.svcbig .sb) per il budget. Si aggiungono solo: testi Black
  Friday, numeri veri nell'apertura (sconto massimo, numero offerte, conto
  alla rovescia) e un nastro che scorre.

  Tutti i numeri vengono dai prodotti della collezione scelta (di default
  "promozioni"): contano solo i prodotti disponibili con prezzo barrato piu'
  alto del prezzo; lo sconto e' calcolato sulla stessa variante, arrotondato
  per difetto. Le offerte sono in ordine esatto di sconto (elenco
  "sconto-inverso-indice" ordinato), senza doppioni per titolo.
{%- endcomment -%}
{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections['promozioni']
  endif
  assign minimo = section.settings.min_discount | default: 15
  assign maxpct = 0
  assign nofferte = 0
  assign seen = '|'
  assign ordine = ''
-%}
{%- paginate col.products by 250 -%}
{%- for p in col.products -%}
  {%- assign v = p.selected_or_first_available_variant -%}
  {%- if p.available and v.compare_at_price > v.price -%}
    {%- assign pct = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
    {%- if pct >= minimo -%}
      {%- assign nofferte = nofferte | plus: 1 -%}
      {%- if pct > maxpct -%}{%- assign maxpct = pct -%}{%- endif -%}
      {%- assign inv = 100 | minus: pct | prepend: '00' | slice: -3, 3 -%}
      {%- assign ordine = ordine | append: inv | append: '-' | append: forloop.index0 | append: ',' -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- assign ordinati = ordine | split: ',' | sort -%}
{%- if section.settings.image != blank -%}
  {%- assign foto = section.settings.image | image_url: width: 3200 -%}
{%- else -%}
  {%- assign foto = 'hero-corsa-nitida.jpg' | file_url -%}
{%- endif -%}

<section class="dzh dzbf" data-dzbf>
  <div class="dzh-stage">
    <div class="dzh-foto" aria-hidden="true">
      <img src="{{ foto }}&width=2400"
           srcset="{{ foto }}&width=1200 1200w, {{ foto }}&width=1800 1800w, {{ foto }}&width=2400 2400w, {{ foto }} 3200w"
           sizes="(max-width: 760px) 240vw, 130vw"
           alt="" width="3200" height="1370" fetchpriority="high"
           onerror="if(!this.dataset.r){this.dataset.r=1;this.removeAttribute('srcset');this.src='{{ 'hero-corsa.jpg' | asset_url }}'}">
    </div>
    <div class="dzh-velo" aria-hidden="true"></div>
    <div class="wrap dzh-testo">
      <div class="dzh-su">
        <p class="dzh-k dzbf-k"><i></i>{{ section.settings.kicker }}</p>
        <h1>{{ section.settings.title }} <span class="g">{% if maxpct > 0 %}{{ section.settings.upto }} -{{ maxpct }}%.{% else %}{{ section.settings.empty_title }}{% endif %}</span></h1>
        <p class="dzh-lede">{% if maxpct > 0 %}{{ section.settings.subtitle | replace: '[n]', nofferte }}{% else %}{{ section.settings.empty_text }}{% endif %}</p>
      </div>
      <div class="dzh-giu">
        <div class="dzh-cta">
          <a class="btn" href="{% if maxpct > 0 %}#offerte{% else %}{{ col.url }}{% endif %}">{{ section.settings.cta }}</a>
          {%- if maxpct > 0 -%}<a class="btn ghost" href="#budget">{{ section.settings.cta_budget }}</a>{%- endif -%}
          <a class="btn ghost" href="{{ section.settings.cta2_link | default: '/pages/finanziamenti-agevolati' }}">{{ section.settings.cta2 }}</a>
        </div>
        {%- if maxpct > 0 -%}
          <div class="dzh-num">
            <div><b class="dzbf-r">-{{ maxpct }}%</b><span>{{ section.settings.stat_max }}</span></div>
            <div><b>{{ nofferte }}</b><span>{{ section.settings.stat_n }}</span></div>
            {%- if section.settings.end_date != blank -%}
              <div class="dzbf-cdw" data-end="{{ section.settings.end_date }}"><b data-cd>&nbsp;</b><span>{{ section.settings.stat_cd }}</span></div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if maxpct > 0 -%}
    <div class="dzbf-tick" aria-hidden="true"><div class="dzbf-tr">
      {%- for i in (1..10) -%}<span>{{ section.settings.tick }}</span><i></i><span>{{ section.settings.upto }} -{{ maxpct }}%</span><i></i>{%- endfor -%}
    </div></div>
  {%- endif -%}
  <script>
    /* menu scuro finche' sotto di lui c'e' l'apertura nera (col nastro); qui la
       fascia marchi viene dopo le offerte, quindi non conta */
    (function(){
      var fascia = document.querySelector('[data-dzbf]');
      var testa = document.querySelector('.dz header'); if (!fascia) return;
      var att = false;
      function buio(){
        att = false;
        var lim = testa ? testa.getBoundingClientRect().bottom : 66;
        document.body.classList.toggle('dz-buio', fascia.getBoundingClientRect().bottom > lim);
      }
      addEventListener('scroll', function(){ if (!att) { att = true; requestAnimationFrame(buio); } }, { passive: true });
      buio();
    })();
    /* conto alla rovescia: "12g 05h 32m 10s" (solo giorni e ore sul telefono), sparisce a offerte finite */
    (function(){
      var w = document.querySelector('[data-dzbf] [data-end]'); if (!w) return;
      var b = w.querySelector('[data-cd]'), fine = new Date(w.dataset.end).getTime();
      if (isNaN(fine)) { w.remove(); return; }
      function due(n){ return (n < 10 ? '0' : '') + n; }
      function tic(){
        var r = Math.floor((fine - Date.now()) / 1000);
        if (r <= 0) { w.remove(); return; }
        var g = Math.floor(r / 86400) + 'g ' + due(Math.floor(r % 86400 / 3600)) + 'h';
        b.textContent = innerWidth < 760 ? g : g + ' ' + due(Math.floor(r % 3600 / 60)) + 'm ' + due(r % 60) + 's';
        setTimeout(tic, 1000);
      }
      tic();
    })();
  </script>
</section>

{%- if maxpct > 0 -%}
  <section class="block wrap fullw" id="offerte" style="padding-top:64px;padding-bottom:20px">
    <div class="head"><div><p class="k">{{ section.settings.top_k }}</p><h2>{{ section.settings.top_h }}</h2></div><a class="more" href="{{ col.url }}">{{ section.settings.all_label | replace: '[n]', nofferte }}</a></div>
    <div class="prods">
      {%- liquid
        assign mostrati = 0
        assign quanti = section.settings.top_count | default: 8
        for k in ordinati
          if mostrati >= quanti
            break
          endif
          assign idx = k | split: '-' | last | plus: 0
          assign p = col.products[idx]
          assign chiave = '|' | append: p.title | append: '|'
          unless seen contains chiave
            assign seen = seen | append: p.title | append: '|'
            render 'dz-card', product: p
            assign mostrati = mostrati | plus: 1
          endunless
        endfor
      -%}
    </div>
  </section>

  <section class="block wrap fullw" id="budget" style="padding-top:56px;padding-bottom:20px">
    <div class="head"><div><p class="k">{{ section.settings.bud_k }}</p><h2>{{ section.settings.bud_h }}</h2></div></div>
    <div class="svcbig">
      <a class="sb" href="{{ col.url }}?filter.v.price.lte=1000">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0L3 13V3h10l7.6 7.6a2 2 0 010 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></span>
        <h3>{{ section.settings.bud_1 }} € 1.000</h3><p>{{ section.settings.bud_1p }}</p><span class="go">{{ section.settings.bud_go }}</span>
      </a>
      <a class="sb" href="{{ col.url }}?filter.v.price.gte=1000&filter.v.price.lte=3000">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="6.5" cy="16.5" r="3.4"/><circle cx="17.5" cy="16.5" r="3.4"/><path d="M6.5 16.5l5-8h4l2 8M11.5 8.5l-1.5-3h3.5"/></svg></span>
        <h3>€ 1.000 – 3.000</h3><p>{{ section.settings.bud_2p }}</p><span class="go">{{ section.settings.bud_go }}</span>
      </a>
      <a class="sb" href="{{ col.url }}?filter.v.price.gte=3000&filter.v.price.lte=5000">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg></span>
        <h3>€ 3.000 – 5.000</h3><p>{{ section.settings.bud_3p }}</p><span class="go">{{ section.settings.bud_go }}</span>
      </a>
      <a class="sb" href="{{ col.url }}?filter.v.price.gte=5000">
        <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5 2 7.5-6.5-4.5L5.5 21l2-7.5L2 9h7z"/></svg></span>
        <h3>{{ section.settings.bud_4 }} € 5.000</h3><p>{{ section.settings.bud_4p }}</p><span class="go">{{ section.settings.bud_go }}</span>
      </a>
    </div>
  </section>

  {%- if nofferte > mostrati -%}
    <section class="block wrap fullw" style="padding-top:64px;padding-bottom:40px">
      <div class="head"><div><p class="k">{{ section.settings.more_k }}</p><h2>{{ section.settings.more_h }}</h2></div><a class="more" href="{{ col.url }}">{{ section.settings.all_label | replace: '[n]', nofferte }}</a></div>
      <div class="prods">
        {%- liquid
          assign altri = 0
          assign quanti2 = section.settings.more_count | default: 12
          for k in ordinati
            if altri >= quanti2
              break
            endif
            assign idx = k | split: '-' | last | plus: 0
            assign p = col.products[idx]
            assign chiave = '|' | append: p.title | append: '|'
            unless seen contains chiave
              assign seen = seen | append: p.title | append: '|'
              render 'dz-card', product: p
              assign altri = altri | plus: 1
            endunless
          endfor
        -%}
      </div>
    </section>
  {%- endif -%}
{%- endif -%}
{%- endpaginate -%}

<style>
  .dzbf .dzbf-k{display:flex;align-items:center;gap:10px;color:#ff5c85}
  .dzbf .dzbf-k i{width:8px;height:8px;border-radius:50%;background:var(--rose,#ff2e63);animation:dzbf-p 1.6s infinite}
  .dzbf .dzbf-r{color:#ff5c85}
  .dzbf .dzbf-cdw b{font-variant-numeric:tabular-nums;white-space:nowrap}
  .dzbf-tick{position:relative;z-index:2;overflow:hidden;background:#000;border-top:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1);padding:14px 0}
  .dzbf-tr{display:flex;align-items:center;gap:26px;width:max-content;animation:dzbf-m 40s linear infinite;font-family:"Archivo",var(--font-sans);font-stretch:118%;font-size:13px;font-weight:600;letter-spacing:.3em;text-transform:uppercase;color:rgba(255,255,255,.8);white-space:nowrap}
  .dzbf-tr span:nth-of-type(even){color:#ff5c85}
  .dzbf-tr i{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.4)}
  @keyframes dzbf-m{to{transform:translateX(-50%)}}
  @keyframes dzbf-p{50%{opacity:.35}}
  @media (prefers-reduced-motion:reduce){.dzbf *,.dzbf-tr{animation:none!important}}
</style>

{% schema %}
{
  "name": "DZ · Black Friday",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collezione delle offerte", "info": "Vuoto = PROMOZIONI. Si vedono solo i prodotti disponibili con prezzo barrato." },
    { "type": "range", "id": "min_discount", "label": "Sconto minimo da mostrare", "min": 5, "max": 50, "step": 5, "unit": "%", "default": 15 },
    { "type": "text", "id": "end_date", "label": "Fine offerte (conto alla rovescia)", "default": "2026-11-30T23:59:00+01:00", "info": "Formato AAAA-MM-GGTHH:MM:SS+01:00. Vuoto = niente conto alla rovescia." },
    { "type": "image_picker", "id": "image", "label": "Foto dell'apertura", "info": "Vuoto = la foto attuale della home." },
    { "type": "text", "id": "kicker", "label": "Occhiello", "default": "Black Week · fino al 30 novembre" },
    { "type": "text", "id": "title", "label": "Titolo (riga sottile)", "default": "Black Friday." },
    { "type": "text", "id": "upto", "label": "Testo prima della percentuale", "default": "Fino al" },
    { "type": "text", "id": "subtitle", "label": "Sottotitolo", "default": "[n] bici in offerta, pronte in negozio e controllate nella nostra officina. Fino a esaurimento scorte.", "info": "[n] = numero di offerte" },
    { "type": "text", "id": "empty_title", "label": "Titolo se non ci sono offerte", "default": "Le offerte stanno arrivando." },
    { "type": "text", "id": "empty_text", "label": "Testo se non ci sono offerte", "default": "Torna a trovarci nei prossimi giorni." },
    { "type": "text", "id": "cta", "label": "Pulsante principale", "default": "Vedi le offerte" },
    { "type": "text", "id": "cta_budget", "label": "Pulsante budget", "default": "Scegli il budget" },
    { "type": "text", "id": "cta2", "label": "Pulsante rate", "default": "Paga a rate" },
    { "type": "url", "id": "cta2_link", "label": "Link pulsante rate" },
    { "type": "text", "id": "stat_max", "label": "Numero 1: etichetta", "default": "SCONTO MASSIMO" },
    { "type": "text", "id": "stat_n", "label": "Numero 2: etichetta", "default": "BICI IN OFFERTA" },
    { "type": "text", "id": "stat_cd", "label": "Numero 3: etichetta", "default": "ALLA FINE DELLE OFFERTE" },
    { "type": "text", "id": "tick", "label": "Testo del nastro", "default": "Black Friday Dal Zilio" },
    { "type": "text", "id": "top_k", "label": "Occhiello offerte top", "default": "Black Friday" },
    { "type": "text", "id": "top_h", "label": "Titolo offerte top", "default": "Le più scontate" },
    { "type": "range", "id": "top_count", "label": "Quante offerte top", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "text", "id": "bud_k", "label": "Occhiello budget", "default": "Black Friday" },
    { "type": "text", "id": "bud_h", "label": "Titolo budget", "default": "Scegli il tuo budget" },
    { "type": "text", "id": "bud_1", "label": "Budget 1: prima del prezzo", "default": "Sotto" },
    { "type": "text", "id": "bud_1p", "label": "Budget 1: testo", "default": "Per iniziare o per la città." },
    { "type": "text", "id": "bud_2p", "label": "Budget 2: testo", "default": "Gravel, trekking ed e-bike per tutti i giorni." },
    { "type": "text", "id": "bud_3p", "label": "Budget 3: testo", "default": "Carbonio, e-MTB e bici da corsa di gamma alta." },
    { "type": "text", "id": "bud_4", "label": "Budget 4: prima del prezzo", "default": "Oltre" },
    { "type": "text", "id": "bud_4p", "label": "Budget 4: testo", "default": "Il top di gamma, in offerta." },
    { "type": "text", "id": "bud_go", "label": "Budget: link", "default": "Vedi le offerte" },
    { "type": "text", "id": "more_k", "label": "Occhiello altre offerte", "default": "Non finisce qui" },
    { "type": "text", "id": "more_h", "label": "Titolo altre offerte", "default": "Altre offerte" },
    { "type": "range", "id": "more_count", "label": "Quante altre offerte", "min": 4, "max": 24, "step": 4, "default": 12 },
    { "type": "text", "id": "all_label", "label": "Link a tutte le offerte", "default": "Tutte le [n] offerte" }
  ]
}
{% endschema %}
