{%- comment -%}
  Categorie della home, "Scegli la tua disciplina": pannelli affiancati su fondo
  nero. Il pannello attivo si allarga (mouse, tastiera o tocco) e mostra numero
  modelli, titolo e pulsante; gli altri restano stretti, in bianco e nero, con
  il titolo in verticale. Su telefono i pannelli si impilano a fisarmonica:
  il primo tocco apre, il secondo porta alla collezione.
  Legge le stesse collezioni e le stesse traduzioni della versione precedente.
{%- endcomment -%}
{%- assign bento = 'usato-1,bici-da-strada,ebikes,gravel,mountain-bike,urban' | split: ',' -%}
<section class="dzd" data-dzd>
  <div class="wrap">
    <div class="dzd-head">
      <h2>{{ 'home.cat_h' | t }}</h2>
      <a class="dzd-all" href="/collections/tutte-le-bici">{{ 'home.cat_all' | t }}</a>
    </div>
    <div class="dzd-rail">
      {%- assign n = 0 -%}
      {%- for handle in bento -%}
        {%- assign c = collections[handle] -%}
        {%- if c != blank -%}
          {%- assign n = n | plus: 1 -%}
          <a class="dzd-p{% if n == 1 %} on{% endif %}" href="{{ c.url }}">
            {%- if c.featured_image -%}
              <img class="dzd-img" src="{{ c.featured_image | image_url: width: 1400 }}"
                   srcset="{{ c.featured_image | image_url: width: 700 }} 700w, {{ c.featured_image | image_url: width: 1400 }} 1400w, {{ c.featured_image | image_url: width: 2000 }} 2000w"
                   sizes="(min-width: 990px) 60vw, 100vw" alt="" loading="lazy">
            {%- endif -%}
            <span class="dzd-sh"></span>
            <span class="dzd-n">0{{ n }}</span>
            <span class="dzd-v">{{ c.title }}</span>
            <span class="dzd-b">
              {%- if forloop.first -%}<span class="dzd-flag"><i></i>{{ 'home.flag_unici' | t }}</span>{%- endif -%}
              <span class="dzd-c">{{ 'home.modelli' | t: n: c.products_count }}</span>
              <span class="dzd-t">{{ c.title }}</span>
              {%- if forloop.first -%}<span class="dzd-p1">{{ 'home.usato_p' | t }}</span>{%- endif -%}
              <span class="dzd-go">{{ 'home.scopri' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <style>
    .dzd{--a:#e4002b;background:radial-gradient(1100px 480px at 88% 0%,rgba(228,0,43,.2),transparent 62%),#0b0b0d;color:#f5f5f2;padding:clamp(48px,7vw,110px) 0}
    .dzd-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:clamp(24px,3.5vw,44px)}
    .dzd-head h2{margin:0;color:#f5f5f2;font-size:clamp(38px,6.4vw,96px);line-height:.92;letter-spacing:-.045em}
    .dzd-all{flex:none;display:inline-flex;align-items:center;padding:13px 22px;border-radius:999px;border:1px solid rgba(255,255,255,.2);color:#f5f5f2;text-decoration:none;font-weight:600;transition:background .3s,color .3s}
    .dzd-all:hover{background:#f5f5f2;color:#0b0b0d}
    .dzd svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .dzd-rail{display:flex;gap:10px;height:clamp(460px,64vh,640px)}
    .dzd-p{position:relative;flex:1 1 0;min-width:0;overflow:hidden;border-radius:22px;color:#f5f5f2;text-decoration:none;isolation:isolate;background:#1a1a1e;transition:flex-grow .7s cubic-bezier(.7,0,.2,1)}
    .dzd-p.on{flex-grow:5}
    .dzd-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transform:scale(1.12);filter:grayscale(.7) brightness(.65);transition:transform 1.2s cubic-bezier(.2,.7,.2,1),filter .7s}
    .dzd-p.on .dzd-img{transform:none;filter:none}
    .dzd-sh{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,.02) 38%,rgba(0,0,0,.85))}
    .dzd-p:after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:var(--a);transform:scaleX(0);transform-origin:left;transition:transform .7s .15s cubic-bezier(.7,0,.2,1)}
    .dzd-p.on:after{transform:scaleX(1)}
    .dzd-n{position:absolute;top:20px;left:20px;font:700 13px/1 ui-monospace,Menlo,monospace;letter-spacing:.1em;color:rgba(245,245,242,.6)}
    .dzd-p.on .dzd-n{color:#fff}
    .dzd-v{position:absolute;left:50%;bottom:28px;transform:translateX(-50%) rotate(180deg);writing-mode:vertical-rl;white-space:nowrap;font-weight:800;font-style:italic;text-transform:uppercase;font-size:clamp(18px,1.8vw,26px);transition:opacity .4s}
    .dzd-p.on .dzd-v{opacity:0}
    .dzd-b{position:absolute;left:0;right:0;bottom:0;padding:clamp(22px,3vw,40px);display:flex;flex-direction:column;align-items:flex-start;gap:10px;opacity:0;transform:translateY(24px);transition:opacity .3s,transform .3s;pointer-events:none}
    .dzd-p.on .dzd-b{opacity:1;transform:none;transition:opacity .6s .35s,transform .6s .35s cubic-bezier(.2,.7,.2,1)}
    .dzd-flag{display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.14);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);font:700 11px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase}
    .dzd-flag i{width:7px;height:7px;border-radius:50%;background:var(--a);animation:dzd-pulse 1.8s infinite}
    .dzd-c{font:600 12px/1 ui-monospace,Menlo,monospace;letter-spacing:.2em;text-transform:uppercase;color:rgba(245,245,242,.75)}
    .dzd-t{font-size:clamp(42px,6.2vw,104px);line-height:.88;font-weight:900;font-style:italic;text-transform:uppercase;letter-spacing:-.035em}
    .dzd-p1{max-width:44ch;color:rgba(255,255,255,.84);font-size:16px;line-height:1.5}
    .dzd-go{margin-top:6px;display:inline-flex;align-items:center;gap:10px;padding:13px 20px;border-radius:999px;background:var(--a);color:#fff;font-weight:700}
    .dzd-go svg{transition:transform .3s}
    .dzd-p:hover .dzd-go svg{transform:translateX(4px)}
    .dzd-p:focus-visible{outline:3px solid var(--a);outline-offset:3px}
    @keyframes dzd-pulse{0%{box-shadow:0 0 0 0 rgba(228,0,43,.7)}70%,100%{box-shadow:0 0 0 8px rgba(228,0,43,0)}}
    @media (max-width:989px){
      .dzd-head{flex-direction:column;align-items:flex-start}
      .dzd-rail{flex-direction:column;height:auto;gap:8px}
      .dzd-p{flex:none;height:84px;transition:height .6s cubic-bezier(.7,0,.2,1)}
      .dzd-p.on{height:440px}
      .dzd-v{writing-mode:horizontal-tb;left:64px;bottom:50%;transform:translateY(50%)}
      .dzd-n{top:50%;transform:translateY(-50%)}
      .dzd-p.on .dzd-n{top:20px;transform:none}
      .dzd-t{font-size:clamp(38px,12vw,64px)}
    }
    @media (prefers-reduced-motion:reduce){.dzd *,.dzd-p{transition:none!important;animation:none!important}}
  </style>
  <script>
    (function(){
      var s = document.querySelector('[data-dzd]'); if (!s) return;
      var ps = s.querySelectorAll('.dzd-p');
      var mq = matchMedia('(hover: hover) and (min-width: 990px)');
      function apri(p){ ps.forEach(function(x){ x.classList.toggle('on', x === p); }); }
      ps.forEach(function(p){
        p.addEventListener('mouseenter', function(){ if (mq.matches) apri(p); });
        p.addEventListener('focus', function(){ if (mq.matches) apri(p); });
        p.addEventListener('click', function(e){ if (!mq.matches && !p.classList.contains('on')) { e.preventDefault(); apri(p); } });
      });
    })();
  </script>
</section>
