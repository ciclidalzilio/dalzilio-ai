{%- comment -%}
  Categorie, "scenografica ma pratica": mosaico di grandi foto (Usato in
  grande, Corsa ed E-Bike larghe, poi Gravel, MTB, Urban), tutte visibili
  subito, niente rotazione automatica. Sopra ogni foto: nome grande, numero
  modelli, prezzo di partenza (il piu' basso tra i primi 50 prodotti
  disponibili) e i marchi della collezione (filtro vendor). Entrata a
  tendina quando la sezione arriva sullo schermo; al passaggio del mouse la
  foto si avvicina e compaiono i marchi. Su telefono: Usato grande, le altre
  due per riga.
{%- endcomment -%}
{%- assign bento = 'usato-1,bici-da-strada,ebikes,gravel,mountain-bike,urban' | split: ',' -%}
{%- if request.locale.iso_code == 'it' -%}{%- assign da = 'da' -%}{%- else -%}{%- assign da = 'from' -%}{%- endif -%}
<section class="block wrap dzb" data-dzb>
  <div class="head"><div><h2>{{ 'home.cat_h' | t }}</h2></div><a class="more" href="/collections/tutte-le-bici">{{ 'home.cat_all' | t }}</a></div>
  <div class="dzb-grid">
    {%- assign n = 0 -%}
    {%- for handle in bento -%}
      {%- assign c = collections[handle] -%}
      {%- if c != blank -%}
        {%- assign n = n | plus: 1 -%}
        {%- assign minp = 0 -%}
        {%- for p in c.products limit: 50 -%}
          {%- if p.available -%}
            {%- if minp == 0 or p.price_min < minp -%}{%- assign minp = p.price_min -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="dzb-t dzb-{{ n }}" style="--i:{{ n }}">
          {%- if c.featured_image -%}<img src="{{ c.featured_image | image_url: width: 1400 }}" srcset="{{ c.featured_image | image_url: width: 600 }} 600w, {{ c.featured_image | image_url: width: 1000 }} 1000w, {{ c.featured_image | image_url: width: 1600 }} 1600w" sizes="(min-width: 990px) {% if n == 1 %}50vw{% else %}34vw{% endif %}, {% if n == 1 %}100vw{% else %}50vw{% endif %}" alt="" loading="lazy">{%- endif -%}
          <span class="dzb-sh"></span>
          <a class="dzb-go" href="{{ c.url }}" aria-label="{{ c.title | escape }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
          {%- if forloop.first -%}<span class="dzb-flag"><i></i>{{ 'home.flag_unici' | t }}</span>{%- endif -%}
          <div class="dzb-b">
            <p class="dzb-m">{{ 'home.modelli' | t: n: c.products_count }}{%- if minp > 0 -%}<span>·</span>{{ da }} <b>{{ minp | money_without_trailing_zeros }}</b>{%- endif -%}</p>
            <h3><a href="{{ c.url }}">{{ c.title }}</a></h3>
            {%- if forloop.first -%}<p class="dzb-p">{{ 'home.usato_p' | t }}</p>{%- endif -%}
            {%- if c.all_vendors.size > 0 -%}
              <div class="dzb-v">
                {%- for v in c.all_vendors limit: 4 -%}<a href="{{ c.url }}?filter.p.vendor={{ v | url_encode }}">{{ v }}</a>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <style>
    .dzb{--a:#e4002b;--e:cubic-bezier(.2,.7,.2,1)}
    .dzb svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
    .dzb-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:clamp(200px,17vw,270px);gap:14px}
    .dzb-1{grid-column:1/7;grid-row:1/3}
    .dzb-2{grid-column:7/13}
    .dzb-3{grid-column:7/13}
    .dzb-4{grid-column:1/5}
    .dzb-5{grid-column:5/9}
    .dzb-6{grid-column:9/13}
    .dzb-t{position:relative;overflow:hidden;border-radius:22px;background:#1b1b1b;color:#fff;isolation:isolate;clip-path:inset(0 round 22px)}
    .dzb.js:not(.in) .dzb-t{clip-path:inset(100% 0 0 0 round 22px)}
    .dzb.js .dzb-t{transition:clip-path 1.1s calc(var(--i) * 90ms) cubic-bezier(.7,0,.2,1)}
    .dzb-t img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transform:scale(1.02);transition:transform 1.4s var(--e)}
    .dzb.js:not(.in) .dzb-t img{transform:scale(1.25)}
    .dzb-t:hover img{transform:scale(1.08)}
    .dzb-sh{position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.25) 0%,rgba(0,0,0,0) 30%,rgba(0,0,0,.1) 50%,rgba(0,0,0,.78) 100%);transition:background .5s}
    .dzb-t:hover .dzb-sh{background:linear-gradient(180deg,rgba(0,0,0,.3) 0%,rgba(0,0,0,.05) 30%,rgba(0,0,0,.25) 50%,rgba(0,0,0,.85) 100%)}
    .dzb-go{position:absolute;top:16px;right:16px;z-index:2;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.18);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;transition:background .3s,color .3s,transform .5s var(--e)}
    .dzb-go:after{content:"";position:absolute;inset:-2000px;z-index:-1}
    .dzb-t:hover .dzb-go{background:#fff;color:#111;transform:rotate(45deg)}
    .dzb-flag{position:absolute;top:18px;left:18px;display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border-radius:999px;background:var(--a);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
    .dzb-flag i{width:7px;height:7px;border-radius:50%;background:#fff;animation:dzb-p 1.6s infinite}
    .dzb-b{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:clamp(18px,2vw,28px);display:flex;flex-direction:column;align-items:flex-start;gap:8px;pointer-events:none}
    .dzb-b a{pointer-events:auto}
    .dzb-m{margin:0;display:flex;align-items:baseline;gap:8px;font-size:14px;color:rgba(255,255,255,.85)}
    .dzb-m b{color:#fff;font-weight:700}
    .dzb-b h3{margin:0;font-size:clamp(28px,2.8vw,44px);line-height:.95;font-weight:800;letter-spacing:-.03em;text-transform:uppercase;font-style:italic}
    .dzb-1 .dzb-b h3{font-size:clamp(48px,5.6vw,92px)}
    .dzb-b h3 a{color:#fff;text-decoration:none}
    .dzb-p{margin:0;max-width:44ch;font-size:15px;line-height:1.5;color:rgba(255,255,255,.85)}
    .dzb-v{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;max-height:0;opacity:0;transform:translateY(8px);transition:max-height .5s var(--e),opacity .35s,transform .5s var(--e)}
    .dzb-t:hover .dzb-v,.dzb-1 .dzb-v{max-height:80px;opacity:1;transform:none}
    .dzb-v a{padding:6px 12px;border-radius:999px;background:rgba(255,255,255,.16);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;text-decoration:none;font-size:12px;font-weight:600;transition:background .2s,color .2s}
    .dzb-v a:hover{background:#fff;color:#111}
    @keyframes dzb-p{50%{opacity:.3}}
    @media (max-width:989px){
      .dzb-grid{grid-template-columns:1fr 1fr;grid-auto-rows:auto;gap:10px}
      .dzb-t{grid-column:auto!important;grid-row:auto!important;aspect-ratio:4/5;border-radius:18px;clip-path:inset(0 round 18px)}
      .dzb-1{grid-column:1/-1!important;aspect-ratio:4/4.4}
      .dzb-6{grid-column:1/-1!important;aspect-ratio:16/10}
      .dzb-go{width:36px;height:36px;top:10px;right:10px}
      .dzb-go svg{width:16px;height:16px}
      .dzb-flag{top:12px;left:12px;padding:6px 10px;font-size:10px}
      .dzb-b{padding:14px}
      .dzb-b h3{font-size:clamp(20px,5.6vw,28px)}
      .dzb-1 .dzb-b h3{font-size:clamp(40px,11vw,56px)}
      .dzb-m{font-size:12px;flex-wrap:wrap;gap:4px}
      .dzb-v{display:none}
      .dzb-1 .dzb-v{display:flex}
    }
    @media (prefers-reduced-motion:reduce){.dzb *{transition:none!important;animation:none!important}}
  </style>
  <script>
    (function(){
      var s = document.querySelector('[data-dzb]'); if (!s || !('IntersectionObserver' in window)) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      s.classList.add('js');
      new IntersectionObserver(function(v, io){ if (v[0].isIntersecting) { s.classList.add('in'); io.disconnect(); } }, { threshold: .15 }).observe(s);
    })();
  </script>
</section>
