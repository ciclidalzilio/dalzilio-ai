{%- comment -%}
  Categorie, idea "Racconto": scorrendo la pagina, a destra passano le
  discipline una alla volta (numero, nome, modelli, pulsante) mentre a
  sinistra la foto resta ferma e cambia con una tendina verso l'alto.
  Accanto alla foto un indice verticale mostra dove sei. Su telefono ogni
  disciplina ha la sua foto sopra il testo, niente parte ferma.
{%- endcomment -%}
{%- assign bento = 'usato-1,bici-da-strada,ebikes,gravel,mountain-bike,urban' | split: ',' -%}
<section class="dzr" data-dzr>
  <div class="wrap">
    <div class="dzr-head">
      <h2>{{ 'home.cat_h' | t }}</h2>
      <a class="dzr-all" href="/collections/tutte-le-bici">{{ 'home.cat_all' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="dzr-grid">
      <div class="dzr-stick">
        <div class="dzr-stage">
          {%- assign n = 0 -%}
          {%- for handle in bento -%}
            {%- assign c = collections[handle] -%}
            {%- if c != blank -%}
              {%- assign n = n | plus: 1 -%}
              <span class="dzr-im{% if n == 1 %} on{% endif %}">{%- if c.featured_image -%}<img src="{{ c.featured_image | image_url: width: 1600 }}" srcset="{{ c.featured_image | image_url: width: 800 }} 800w, {{ c.featured_image | image_url: width: 1600 }} 1600w" sizes="50vw" alt="" loading="lazy">{%- endif -%}</span>
            {%- endif -%}
          {%- endfor -%}
          <span class="dzr-num" aria-hidden="true"><b data-cur>01</b> / 0{{ n }}</span>
        </div>
        <div class="dzr-idx" aria-hidden="true">{%- for i in (1..n) -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}</div>
      </div>
      <div class="dzr-list">
        {%- assign n = 0 -%}
        {%- for handle in bento -%}
          {%- assign c = collections[handle] -%}
          {%- if c != blank -%}
            {%- assign n = n | plus: 1 -%}
            <article class="dzr-it{% if n == 1 %} on{% endif %}" data-i="{{ n | minus: 1 }}">
              <span class="dzr-mob">{%- if c.featured_image -%}<img src="{{ c.featured_image | image_url: width: 900 }}" alt="" loading="lazy">{%- endif -%}</span>
              <p class="dzr-k">0{{ n }}{% if forloop.first %}<span>{{ 'home.flag_unici' | t }}</span>{% endif %}</p>
              <h3><a href="{{ c.url }}">{{ c.title }}</a></h3>
              <p class="dzr-p">
                {%- if forloop.first -%}{{ 'home.usato_p' | t }}{%- else -%}{{ c.description | strip_html | strip | truncatewords: 26 }}{%- endif -%}
              </p>
              <div class="dzr-row">
                <a class="dzr-go" href="{{ c.url }}">{{ 'home.scopri' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                <span class="dzr-c">{{ 'home.modelli' | t: n: c.products_count }}</span>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <style>
    .dzr{--ink:#111;--mute:#8a8a8a;--a:#e4002b;--e:cubic-bezier(.65,0,.35,1);background:#fff;color:var(--ink);padding:clamp(72px,10vw,150px) 0}
    .dzr svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .dzr-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:clamp(40px,5vw,72px)}
    .dzr-head h2{margin:0;max-width:12ch;font-size:clamp(44px,6.6vw,104px);line-height:.92;font-weight:700;letter-spacing:-.045em;color:var(--ink)}
    .dzr-all{display:inline-flex;align-items:center;gap:12px;color:var(--ink);text-decoration:none;font-size:13px;letter-spacing:.22em;text-transform:uppercase;padding-bottom:6px;border-bottom:1px solid var(--ink);white-space:nowrap}
    .dzr-all:hover{color:var(--a);border-color:var(--a)}
    .dzr-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(40px,6vw,110px);align-items:start}
    .dzr-stick{position:sticky;top:max(90px,calc(50vh - 38vh));display:flex;gap:22px;align-items:center}
    .dzr-stage{position:relative;flex:1;height:min(76vh,760px);border-radius:6px;overflow:hidden;background:#eee}
    .dzr-im{position:absolute;inset:0;clip-path:inset(100% 0 0 0);transition:clip-path 1.1s var(--e);z-index:1}
    .dzr-im.on{clip-path:inset(0 0 0 0);z-index:2}
    .dzr-im.was{clip-path:inset(0 0 0 0);z-index:1}
    .dzr-im img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.15);transition:transform 1.6s var(--e)}
    .dzr-im.on img{transform:scale(1)}
    .dzr-num{position:absolute;left:24px;bottom:22px;z-index:3;color:#fff;font-size:13px;letter-spacing:.22em;text-shadow:0 1px 12px rgba(0,0,0,.4)}
    .dzr-num b{font-weight:600}
    .dzr-idx{display:flex;flex-direction:column;gap:10px}
    .dzr-idx i{display:block;width:2px;height:28px;background:rgba(17,17,17,.14);transition:background .5s,height .6s var(--e)}
    .dzr-idx i.on{background:var(--a);height:56px}
    .dzr-list{display:flex;flex-direction:column}
    .dzr-it{min-height:min(76vh,760px);display:flex;flex-direction:column;justify-content:center;gap:22px;padding:40px 0;border-top:1px solid rgba(17,17,17,.1);opacity:.18;transition:opacity .7s var(--e)}
    .dzr-it:first-child{border-top:0}
    .dzr-it.on{opacity:1}
    .dzr-mob{display:none}
    .dzr-k{margin:0;display:flex;align-items:center;gap:14px;font-size:13px;letter-spacing:.3em;color:var(--a)}
    .dzr-k span{padding:6px 12px;border-radius:999px;background:var(--ink);color:#fff;font-size:10px;letter-spacing:.22em;text-transform:uppercase}
    .dzr-it h3{margin:0;font-size:clamp(48px,6.4vw,104px);line-height:.9;font-weight:700;letter-spacing:-.045em}
    .dzr-it h3 a{color:inherit;text-decoration:none}
    .dzr-p{margin:0;max-width:42ch;font-size:18px;line-height:1.6;color:#555}
    .dzr-p:empty{display:none}
    .dzr-row{display:flex;align-items:center;gap:28px;margin-top:6px}
    .dzr-go{display:inline-flex;align-items:center;gap:14px;height:56px;padding:0 30px;border-radius:999px;background:var(--ink);color:#fff;text-decoration:none;font-size:13px;letter-spacing:.2em;text-transform:uppercase;transition:background .35s}
    .dzr-go:hover{background:var(--a)}
    .dzr-go svg{transition:transform .35s var(--e)}.dzr-go:hover svg{transform:translateX(4px)}
    .dzr-c{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--mute)}
    @media (max-width:989px){
      .dzr-head{flex-direction:column;align-items:flex-start}
      .dzr-grid{grid-template-columns:1fr}
      .dzr-stick{display:none}
      .dzr-it{min-height:0;opacity:1;padding:0 0 48px;border:0;gap:16px}
      .dzr-mob{display:block;aspect-ratio:4/5;border-radius:6px;overflow:hidden;background:#eee;margin-bottom:6px}
      .dzr-mob img{width:100%;height:100%;object-fit:cover;display:block}
      .dzr-p{font-size:16px}
      .dzr-it h3{font-size:clamp(40px,11vw,60px)}
    }
    @media (prefers-reduced-motion:reduce){.dzr *{transition:none!important}}
  </style>
  <script>
    (function(){
      var s = document.querySelector('[data-dzr]'); if (!s || !('IntersectionObserver' in window)) return;
      var its = [].slice.call(s.querySelectorAll('.dzr-it')), ims = [].slice.call(s.querySelectorAll('.dzr-im'));
      var tick = [].slice.call(s.querySelectorAll('.dzr-idx i')), cur = s.querySelector('[data-cur]'), idx = 0, t;
      function apri(i){
        if (i === idx) return;
        clearTimeout(t); ims.forEach(function(x){ x.classList.remove('was'); });
        var vecchio = ims[idx]; vecchio.classList.add('was'); t = setTimeout(function(){ vecchio.classList.remove('was'); }, 1150);
        idx = i;
        [its, ims, tick].forEach(function(g){ g.forEach(function(x, j){ x.classList.toggle('on', j === i); }); });
        if (cur) cur.textContent = ('0' + (i + 1)).slice(-2);
      }
      var io = new IntersectionObserver(function(v){
        v.forEach(function(e){ if (e.isIntersecting) apri(+e.target.dataset.i); });
      }, { rootMargin: '-45% 0px -45% 0px' });
      its.forEach(function(x){ io.observe(x); });
    })();
  </script>
</section>
