{%- comment -%}
  Scheda offerta Black Friday. Riceve product, variant (la stessa usata per
  calcolare lo sconto), pct (sconto intero gia' calcolato) e top (true per la
  fascia "piu' scontate": percentuale piu' grande). Prezzo, prezzo barrato e
  risparmio sono quelli della variante. Stili nella sezione dz-black-friday.
{%- endcomment -%}
{%- assign risp = variant.compare_at_price | minus: variant.price -%}
<a class="dzbc{% if top %} top{% endif %}" href="{{ product.url }}">
  <span class="dzbc-ph">
    {%- assign img = variant.featured_image | default: product.featured_image -%}
    {%- if img -%}<img src="{{ img | image_url: width: 700 }}" srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w" sizes="(min-width: 990px) 25vw, 50vw" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}
    <span class="dzbc-pct">-{{ pct }}<small>%</small></span>
  </span>
  <span class="dzbc-b">
    <span class="dzbc-v">{{ product.vendor }}</span>
    <span class="dzbc-t">{{ product.title }}</span>
    <span class="dzbc-pr"><b>{{ variant.price | money_without_trailing_zeros }}</b><s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s></span>
    <span class="dzbc-r">Risparmi {{ risp | money_without_trailing_zeros }}</span>
  </span>
</a>
