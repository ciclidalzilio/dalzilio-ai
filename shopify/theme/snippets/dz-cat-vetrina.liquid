{%- comment -%}
  Categorie, "Vetrina" in stile Apple: fondo grigio chiaro, carattere di
  sistema (SF su Apple), niente maiuscolo corsivo. A sinistra le discipline
  come pillole con il "+": quella attiva si apre in una scheda bianca con
  numero modelli e link. A destra la foto grande cambia in dissolvenza.
  Sotto la foto i puntini di avanzamento e il tasto pausa, come nelle
  gallerie di apple.com. Gira da sola finche' e' sullo schermo, il mouse non
  e' sulle pillole e non e' in pausa. Su telefono le pillole scorrono in
  orizzontale e il testo sta sopra la foto.
{%- endcomment -%}
{%- assign bento = 'usato-1,bici-da-strada,ebikes,gravel,mountain-bike,urban' | split: ',' -%}
<section class="dza" data-dza>
  <div class="wrap">
    <div class="dza-head">
      <h2>{{ 'home.cat_h' | t }}.</h2>
      <a class="dza-link" href="/collections/tutte-le-bici">{{ 'home.cat_all' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
    </div>
    <div class="dza-grid">
      <div class="dza-list" role="tablist">
        {%- assign n = 0 -%}
        {%- for handle in bento -%}
          {%- assign c = collections[handle] -%}
          {%- if c != blank -%}
            {%- assign n = n | plus: 1 -%}
            <div class="dza-it{% if n == 1 %} on{% endif %}">
              <button class="dza-pill" type="button" role="tab" aria-selected="{% if n == 1 %}true{% else %}false{% endif %}">
                <span class="dza-plus" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 6v12M6 12h12"/></svg></span>
                <span class="dza-nm">{{ c.title }}</span>
              </button>
              <div class="dza-card">
                {%- if forloop.first -%}
                  {%- assign d = 'home.usato_p' | t -%}
                {%- else -%}
                  {%- assign d = c.description | strip_html | strip | truncatewords: 22 -%}
                {%- endif -%}
                <p class="dza-ct"><b>{{ c.title }}.</b> {{ d }}</p>
                <p class="dza-meta">{%- if forloop.first -%}<span class="dza-flag">{{ 'home.flag_unici' | t }}</span>{%- endif -%}{{ 'home.modelli' | t: n: c.products_count }}</p>
                <a class="dza-link" href="{{ c.url }}">{{ 'home.scopri' | t }}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></a>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="dza-right">
        <div class="dza-stage">
          {%- assign n = 0 -%}
          {%- for handle in bento -%}
            {%- assign c = collections[handle] -%}
            {%- if c != blank -%}
              {%- assign n = n | plus: 1 -%}
              <a class="dza-sl{% if n == 1 %} on{% endif %}" href="{{ c.url }}" tabindex="{% if n == 1 %}0{% else %}-1{% endif %}" aria-label="{{ c.title | escape }}">
                {%- if c.featured_image -%}<img src="{{ c.featured_image | image_url: width: 1600 }}" srcset="{{ c.featured_image | image_url: width: 800 }} 800w, {{ c.featured_image | image_url: width: 1600 }} 1600w, {{ c.featured_image | image_url: width: 2200 }} 2200w" sizes="(min-width: 990px) 62vw, 100vw" alt="" loading="lazy">{%- endif -%}
                <span class="dza-cap"><b>{{ c.title }}</b><span>{{ 'home.modelli' | t: n: c.products_count }}</span></span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="dza-ctl">
          <div class="dza-dots">
            {%- for i in (1..n) -%}<button class="dza-dot{% if forloop.first %} on{% endif %}" type="button" aria-label="{{ i }} / {{ n }}"><i></i></button>{%- endfor -%}
          </div>
          <button class="dza-play" type="button" aria-label="Pausa" data-play>
            <svg class="p1" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg>
            <svg class="p2" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" fill="currentColor" stroke="none"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <style>
    .dza{--ink:#1d1d1f;--mute:#6e6e73;--a:#e4002b;--dur:5s;--e:cubic-bezier(.28,.11,.32,1);background:#f5f5f7;color:var(--ink);padding:clamp(64px,9vw,140px) 0;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
    .dza svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
    .dza-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:clamp(32px,4vw,56px)}
    .dza-head h2{margin:0;font-family:inherit;font-size:clamp(34px,4.6vw,64px);line-height:1.06;font-weight:600;letter-spacing:-.022em;color:var(--ink)}
    .dza-link{display:inline-flex;align-items:center;gap:2px;color:var(--a);text-decoration:none;font-size:17px;font-weight:400;letter-spacing:-.01em;white-space:nowrap}
    .dza-link svg{width:14px;height:14px;transition:transform .3s var(--e)}
    .dza-link:hover{text-decoration:underline}
    .dza-link:hover svg{transform:translateX(3px)}
    .dza-grid{display:grid;grid-template-columns:minmax(280px,4fr) 8fr;gap:clamp(24px,3vw,48px);align-items:center}
    .dza-list{display:flex;flex-direction:column;align-items:flex-start;gap:12px}
    .dza-it{max-width:100%}
    .dza-pill{display:inline-flex;align-items:center;gap:14px;height:56px;padding:0 26px 0 12px;border:0;border-radius:999px;background:rgba(232,232,237,.9);color:var(--ink);font:inherit;font-size:17px;font-weight:600;letter-spacing:-.01em;cursor:pointer;transition:background .3s var(--e),transform .3s var(--e)}
    .dza-pill:hover{background:#dcdce1}
    .dza-pill:active{transform:scale(.97)}
    .dza-plus{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:#fff;flex:none;transition:transform .45s var(--e),background .3s}
    .dza-card{display:none}
    .dza-it.on .dza-pill{display:none}
    .dza-it.on .dza-card{display:flex;flex-direction:column;align-items:flex-start;gap:14px;max-width:440px;padding:28px 30px;border-radius:28px;background:#fff;box-shadow:0 2px 12px rgba(0,0,0,.04);transform-origin:left center;animation:dza-in .55s var(--e)}
    .dza-ct{margin:0;font-size:17px;line-height:1.47;letter-spacing:-.01em;color:var(--mute)}
    .dza-ct b{color:var(--ink);font-weight:600}
    .dza-meta{margin:0;display:flex;align-items:center;gap:10px;font-size:14px;color:var(--mute)}
    .dza-flag{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;background:rgba(228,0,43,.1);color:var(--a);font-size:12px;font-weight:600}
    .dza-right{min-width:0}
    .dza-stage{position:relative;aspect-ratio:16/11;border-radius:30px;overflow:hidden;background:#e8e8ed}
    .dza-sl{position:absolute;inset:0;opacity:0;transition:opacity .8s var(--e);color:#fff;text-decoration:none}
    .dza-sl.on{opacity:1;z-index:1}
    .dza-sl img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.06);transition:transform 1.4s var(--e)}
    .dza-sl.on img{transform:none}
    .dza-cap{display:none}
    .dza-ctl{display:flex;justify-content:center;align-items:center;gap:14px;margin-top:26px}
    .dza-dots{display:flex;align-items:center;gap:12px;height:56px;padding:0 24px;border-radius:999px;background:rgba(232,232,237,.9)}
    .dza-dot{position:relative;width:8px;height:8px;padding:0;border:0;border-radius:999px;background:rgba(29,29,31,.35);cursor:pointer;overflow:hidden;transition:width .45s var(--e),background .3s}
    .dza-dot:hover{background:rgba(29,29,31,.6)}
    .dza-dot.on{width:48px;background:rgba(29,29,31,.2)}
    .dza-dot i{position:absolute;inset:0;background:var(--ink);border-radius:inherit;transform:scaleX(0);transform-origin:left}
    .dza-dot.on i{transform:scaleX(1)}
    .dza.auto .dza-dot.on i{animation:dza-prog var(--dur) linear forwards}
    .dza-play{width:56px;height:56px;border-radius:50%;border:0;background:rgba(232,232,237,.9);color:var(--ink);display:grid;place-items:center;cursor:pointer;transition:background .3s}
    .dza-play:hover{background:#dcdce1}
    .dza-play svg{width:18px;height:18px}
    .dza-play .p2,.dza.paused .dza-play .p1{display:none}
    .dza.paused .dza-play .p2{display:block}
    @keyframes dza-prog{from{transform:scaleX(0)}to{transform:scaleX(1)}}
    @keyframes dza-in{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:none}}
    @media (max-width:989px){
      .dza-head{flex-direction:column;align-items:flex-start;gap:10px}
      .dza-grid{grid-template-columns:minmax(0,1fr)}
      .dza-list{flex-direction:row;overflow-x:auto;gap:8px;margin:0 calc(-1 * clamp(16px,3vw,40px));padding:0 clamp(16px,3vw,40px) 4px;scrollbar-width:none;order:2}
      .dza-list::-webkit-scrollbar{display:none}
      .dza-it{flex:none}
      .dza-it.on .dza-pill{display:inline-flex;background:var(--ink);color:#fff}
      .dza-it.on .dza-plus{background:#fff;color:var(--ink);transform:rotate(45deg)}
      .dza-pill{height:44px;font-size:15px;padding:0 18px 0 8px;gap:10px}
      .dza-plus{width:28px;height:28px}
      .dza-card{display:none!important}
      .dza-right{order:1}
      .dza-stage{aspect-ratio:4/5;border-radius:24px}
      .dza-cap{display:flex;flex-direction:column;gap:4px;position:absolute;left:0;right:0;bottom:0;padding:60px 22px 22px;background:linear-gradient(180deg,transparent,rgba(0,0,0,.55))}
      .dza-cap b{font-size:28px;font-weight:600;letter-spacing:-.02em}
      .dza-cap span{font-size:15px;opacity:.85}
      .dza-ctl{margin:18px 0 20px}
      .dza-dots{height:44px;padding:0 18px;gap:10px}
      .dza-play{width:44px;height:44px}
    }
    @media (prefers-reduced-motion:reduce){.dza *{transition:none!important;animation:none!important}}
  </style>
  <script>
    (function(){
      var s = document.querySelector('[data-dza]'); if (!s) return;
      var its = [].slice.call(s.querySelectorAll('.dza-it')), sl = [].slice.call(s.querySelectorAll('.dza-sl')), dots = [].slice.call(s.querySelectorAll('.dza-dot'));
      var play = s.querySelector('[data-play]'), list = s.querySelector('.dza-list');
      var calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var idx = 0, vis = false, sopra = false, pausa = calmo;
      if (calmo) s.classList.add('paused');
      function riavvia(){ s.classList.remove('auto'); void s.offsetWidth; auto(); }
      function apri(i){
        i = (i + its.length) % its.length; if (i === idx) return;
        idx = i;
        [its, sl, dots].forEach(function(g){ g.forEach(function(x, j){ x.classList.toggle('on', j === i); }); });
        its.forEach(function(x, j){ x.querySelector('.dza-pill').setAttribute('aria-selected', j === i); });
        sl.forEach(function(x, j){ x.tabIndex = j === i ? 0 : -1; });
        if (innerWidth < 990) list.scrollTo({ left: its[i].offsetLeft - 16, behavior: 'smooth' });
      }
      function auto(){ s.classList.toggle('auto', vis && !sopra && !pausa); }
      its.forEach(function(it, i){ it.querySelector('.dza-pill').addEventListener('click', function(){ apri(i); riavvia(); }); });
      dots.forEach(function(d, i){
        d.addEventListener('click', function(){ apri(i); riavvia(); });
        d.querySelector('i').addEventListener('animationend', function(){ if (s.classList.contains('auto')) apri(i + 1); });
      });
      play.addEventListener('click', function(){
        pausa = !pausa; s.classList.toggle('paused', pausa);
        play.setAttribute('aria-label', pausa ? 'Riproduci' : 'Pausa'); auto();
      });
      list.addEventListener('mouseenter', function(){ sopra = true; auto(); });
      list.addEventListener('mouseleave', function(){ sopra = false; auto(); });
      if ('IntersectionObserver' in window) new IntersectionObserver(function(v){ vis = v[0].isIntersecting; auto(); }, { threshold: .4 }).observe(s);
    })();
  </script>
</section>
